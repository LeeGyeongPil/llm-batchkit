{
  "name": "llm-batchkit",
  "version": "0.1.1",
  "description": "Lint, split, submit, merge and retry LLM Batch API files (OpenAI, Azure OpenAI, Anthropic) from the command line.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "llm-batchkit": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "keywords": [
    "openai",
    "batch",
    "jsonl",
    "anthropic",
    "azure",
    "cli",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeeGyeongPil/llm-batchkit.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && vitest run",
    "demo": "npm run build && node scripts/demo.mjs",
    "prepare": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
